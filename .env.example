# Külünk Teknoloji — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası asla commit edilmez (.gitignore ile korunur).

# KIE.AI API Anahtarı (kie.ai panelinden alın)
# Vercel deployment için: Dashboard → Project → Settings → Environment Variables
KIE_API_KEY=your_kie_api_key_here

# Formspree Form ID (formspree.io üzerinden kayıt olarak alın)
# index.html ve iletisim/index.html içindeki "formspree.io/f/placeholder" ile değiştirin
FORMSPREE_FORM_ID=your_formspree_form_id_here
